// Cloudflare で out/ の書き出し結果をそのまま配る設定。
// 実行するプログラムは置かず、ファイルの配信だけにしている（無料で回数無制限）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hsp-ink",
  "compatibility_date": "2026-10-01",
  // 本番の住所。www.hsp.ink は、いまは Vercel 側の転送で hsp.ink に来る
  "routes": [{ "pattern": "hsp.ink", "custom_domain": true }],
  // 試験用の住所（hsp-ink.fukukita.workers.dev）は閉じる。canonical のない同じページを増やさない
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
