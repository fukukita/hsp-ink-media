        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "df79f12cb333",
        "_type": "block",
        "children": [
          {
            "_key": "1ecfd0744b1e",
            "_type": "span",
            "marks": [],
            "text": "HSPは「気質」でADHDは「医学的な診断」"
